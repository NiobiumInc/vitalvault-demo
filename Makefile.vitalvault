# Makefile.vitalvault — turnkey build + verification for the VitalVault example
# ===========================================================================
# ILLUSTRATIVE / DEMO-ONLY. NOT A MEDICAL DEVICE. NOT FOR CLINICAL USE.
#
# Run from the repository root (where this file lives):
#     make -f Makefile.vitalvault vitalvault-check  # DSL semantic check (no build)
#     make -f Makefile.vitalvault vitalvault        # DSL -> C++ -> binaries
#     make -f Makefile.vitalvault test-vitalvault   # full record->replay->decrypt
#
# The Niobium DSL compiler + FHE toolchain live in the vendored submodule at
# third_party/niobium-client (clone this repo with --recurse-submodules). The
# encrypted build/test targets additionally require that client stack to be
# built once:
#     make -C third_party/niobium-client build-release
# which provides vendor/lib/openfhe and libnbfhetch. WITHOUT that, only the
# DSL->C++ compile and vitalvault-check steps (which need no FHE runtime) will
# succeed.
# ===========================================================================

# Standalone-repo layout: this Makefile lives at the repo root, the Niobium
# client is vendored as a git submodule under third_party/, and the VitalVault
# example is a top-level directory. Paths are absolute so recipes can `cd` into
# the compiler directory without breaking relative references.
REPO_ROOT           := $(CURDIR)
NIOBIUM_CLIENT_ROOT ?= $(REPO_ROOT)/third_party/niobium-client
XCOMP               := $(NIOBIUM_CLIENT_ROOT)/dsl_fhe/xcomp
NPROC               := $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

VV_DIR    := $(REPO_ROOT)/vitalvault
VV_NB_OUT := $(VV_DIR)/nb_out

LD_LIB_PATH := $(NIOBIUM_CLIENT_ROOT)/vendor/lib/openfhe/lib:$(NIOBIUM_CLIENT_ROOT)/build/vendor/niobium-fhetch:$(NIOBIUM_CLIENT_ROOT)/vendor/niobium-fhetch/build:$(NIOBIUM_CLIENT_ROOT)/build/_deps/yaml_cpp-build
NBCC_FHETCH_DRIVER ?= $(NIOBIUM_CLIENT_ROOT)/vendor/niobium-fhetch/build/tests/fhetch_driver/fhetch_driver
export NBCC_FHETCH_DRIVER

# OpenFHE install produced by `make -C third_party/niobium-client build-release`.
# Reused (never rebuilt) when building fhetch_driver below.
OPENFHE_INSTALL_DIR ?= $(NIOBIUM_CLIENT_ROOT)/vendor/lib/openfhe

.PHONY: vitalvault test-vitalvault vitalvault-check vitalvault-cohort clean-vitalvault

# --- DSL -> C++ -> binaries -------------------------------------------------
vitalvault:
	@echo "=== Compiling VitalVault (DSL -> C++) ==="
	@mkdir -p $(VV_NB_OUT)
	@cd $(XCOMP) && PYTHONPATH=.. python3 -m xcomp.nbc compile \
		$(VV_DIR)/shared.niob \
		$(VV_DIR)/client.niob \
		$(VV_DIR)/server.niob \
		--outdir $(VV_NB_OUT)
	@echo ""
	@echo "=== Building VitalVault (C++ -> binaries) ==="
	@mkdir -p $(VV_NB_OUT)/build
	@cd $(VV_NB_OUT)/build && \
		cmake .. -DNIOBIUM_CLIENT_ROOT=$(NIOBIUM_CLIENT_ROOT) && \
		$(MAKE) -j$(NPROC) 2>&1
	@echo ""
	@echo "Built binaries in $(VV_NB_OUT)/build/"

# --- Semantic check only (no build; runs anywhere) --------------------------
vitalvault-check:
	@cd $(XCOMP) && PYTHONPATH=.. python3 -m xcomp.nbc check \
		$(VV_DIR)/shared.niob $(VV_DIR)/client.niob $(VV_DIR)/server.niob

# --- Stage-3 ground truth (cleartext; runs anywhere) ------------------------
vitalvault-cohort:
	@cd $(VV_DIR) && python3 -m harness.gen_profiles review && \
		python3 -m harness.gen_profiles cohort 50

# --- Full encrypted verification (REQUIRES built niobium-client stack) ------
# Generates the Stage-3 ground truth + binary inputs for a persona, runs the
# four-stage encrypted pipeline (key_generation -> encrypt_profile ->
# compute_wellness -> decrypt_report), then runs the cleartext reference twins
# and confirms the decrypted scores match reference.json within tolerance.
# The cooperative-replay helper compute_wellness spawns. It is NOT produced by
# `make -C third_party/niobium-client build-release` (that populates build/
# only); it lives in the niobium-fhetch submodule's own build tree. Build it
# via the submodule's official config+build targets, reusing the already-
# installed OpenFHE (EXTERNAL_OPENFHE=1) so OpenFHE is not recompiled. As a
# file target this runs only when the binary is absent.
$(NBCC_FHETCH_DRIVER):
	$(MAKE) -C $(NIOBIUM_CLIENT_ROOT)/vendor/niobium-fhetch \
		EXTERNAL_OPENFHE=1 \
		OPENFHE_INSTALL_DIR=$(OPENFHE_INSTALL_DIR) \
		config-fhetch-release build-release

test-vitalvault: vitalvault $(NBCC_FHETCH_DRIVER)
	@echo ""
	@echo "=== Testing VitalVault (end-to-end, toy profile) ==="
	@echo "    ILLUSTRATIVE/DEMO-ONLY, non-diagnostic."
	@cd $(VV_DIR) && \
		export LD_LIBRARY_PATH=$(LD_LIB_PATH) && \
		rm -rf io *_workload_* fhetch_driver_source_* && \
		B=nb_out/build && \
		echo "  endurance_athlete persona (the direction-sensitive case)..." && \
		python3 -m harness.gen_profiles persona endurance_athlete --as-profile toy && \
		mkdir -p io/toy/keys io/toy/encrypted && \
		$$B/key_generation 0 && \
		$$B/encrypt_profile 0 && \
		$$B/compute_wellness 0 --no-ring-dim-check && \
		$$B/decrypt_report 0 35.0 && \
		echo "  (compare printed scores to io/toy/reference.json" && \
		echo "   system_scores_raw; differences are CKKS noise)" && \
		echo "" && \
		echo "  cleartext reference twins (generated ground truth)..." && \
		$$B/encrypt_profile_ref 0 && \
		$$B/compute_wellness_ref 0 && \
		$$B/decrypt_report_ref 0 35.0 && \
		echo "  PASS  reference pipeline agrees" && \
		rm -rf *_workload_* fhetch_driver_source_* && \
		echo "" && echo "VitalVault end-to-end complete (verify scores vs reference.json)."

clean-vitalvault:
	@rm -rf $(VV_DIR)/nb_out $(VV_DIR)/io $(VV_DIR)/*_workload_* \
		$(VV_DIR)/fhetch_driver_source_*
	@echo "cleaned vitalvault generated artifacts"
